{
  "name": "cyclic-study-management-portal",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "dotenv -- turbo run dev",
    "predev:web": "node scripts/kill-dev-orphans.mjs",
    "dev:web": "dotenv -- turbo run dev --filter=web",
    "dev:api": "dotenv -- turbo run dev --filter=api",
    "dev:workers": "dotenv -- turbo run dev --filter=workers",
    "dev:back": "dotenv -- turbo run dev --filter=api --filter=workers",
    "dev:full": "dotenv -- turbo run dev --filter=web --filter=api --filter=workers",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:studio": "dotenv -- pnpm --filter @repo/database exec prisma studio",
    "db:generate": "dotenv -- pnpm --filter @repo/database exec prisma generate",
    "db:migrate": "dotenv -- pnpm --filter @repo/database exec prisma migrate deploy",
    "db:migrate:dev": "dotenv -- pnpm --filter @repo/database exec prisma migrate dev",
    "db:status": "dotenv -- pnpm --filter @repo/database run db:status",
    "db:seed": "dotenv -- pnpm --filter @repo/database exec tsx prisma/seed/index.ts",
    "release": "bash deploy.sh"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "autocannon": "^8.0.0",
    "dotenv-cli": "^11.0.0",
    "prettier": "^3.7.4",
    "turbo": "^2.9.18",
    "typescript": "5.9.2",
    "undici": "^8.7.0"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
